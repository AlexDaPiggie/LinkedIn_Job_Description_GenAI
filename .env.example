# Copy to .env and fill in. Every variable the backend reads is listed here.
# [secret] = server only, never commit or send to the browser.
# Features degrade safely when optional values are missing (see docs/DEPLOYMENT.md).

# --- LLM (required) ---
OPENROUTER_API_KEY=            # [secret] https://openrouter.ai/keys

# --- Supabase: auth + Postgres (required for sign-in and credits) ---
SUPABASE_URL=                  # https://<project>.supabase.co
SUPABASE_ANON_KEY=             # public anon key
SUPABASE_SERVICE_ROLE_KEY=     # [secret] needed for the credit ledger functions

# --- Stripe: credit packs (required for payments) ---
STRIPE_SECRET_KEY=             # [secret] sk_test_... locally, sk_live_... in production
STRIPE_WEBHOOK_SECRET=         # [secret] whsec_... (from `stripe listen` locally)

# --- Cloudflare Turnstile: bot check (optional, skipped when unset) ---
TURNSTILE_SITE_KEY=            # public
TURNSTILE_SECRET_KEY=          # [secret]

# --- Abuse limits (optional, defaults shown) ---
GUEST_DAILY_LIMIT=10           # free LLM calls per IP per day
GLOBAL_DAILY_LLM_CALLS=3000    # daily kill switch across all users
USER_HOURLY_LIMIT=60           # LLM calls per signed-in user per hour
TRUSTED_PROXY_HOPS=1           # proxies in front of the app (Cloudflare -> Cloud Run)
DISPOSABLE_EMAIL_DOMAINS=      # extra blocked email domains, comma separated
